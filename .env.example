# ── Required ──────────────────────────────────────────────────────────────
# From @BotFather. Rotate it if it was ever stored somewhere you don't control.
BOT_TOKEN=your_telegram_bot_token
# Private subscriber channel (starts with -100...)
CHANNEL_ID=-1001234567890
# Supabase project holding the bot's own tables (vigil_*, auspex_bot_*). Recommended: the SAME project
# as the site/worker (qwykkcsyoghljgndnvaz), so one project holds everything.
SUPABASE_URL=https://your-project.supabase.co
# service_role key (server-side only, never in the site). Needed once migrations/003 is applied.
SUPABASE_SERVICE_KEY=your_service_role_key
# Legacy: anon key only. Works until 003 is applied, but lets anyone with the anon key write the bot's tables.
# SUPABASE_ANON_KEY=

# Payment receive wallets
BASE_RECEIVE_ADDR=0x_your_base_wallet_address
SOLANA_RECEIVE_ADDR=your_solana_wallet_address

# ── Auspex data (same cache the site reads) ───────────────────────────────
# Only needed if the worker/site project differs from SUPABASE_URL above.
# AUSPEX_SUPABASE_URL=https://qwykkcsyoghljgndnvaz.supabase.co
# AUSPEX_SUPABASE_ANON_KEY=the_sites_public_anon_key
AUSPEX_SITE_URL=https://auspex-site.vercel.app

# ── Alerts ────────────────────────────────────────────────────────────────
ALERTS_ENABLED=true
# true = only active subscribers (and the owner) can turn alerts on
ALERTS_REQUIRE_SUBSCRIPTION=true
# Poll interval for the worker cache (the worker writes every ~90s)
ALERT_POLL_MS=60000
# ALERTS_DEBUG=1            # log a per-tick summary (sent / duplicate / rate-limited)
# OUTCOMES_TTL_MS=300000    # cache for stats aggregated from auspex_signal_outcomes (only used when the
#                           # worker payload has no signalPerformance)

# ── Recommended ───────────────────────────────────────────────────────────
# Your Telegram user id. Owner-only commands (/addaccount, /watchlist...) are refused when unset.
OWNER_TELEGRAM_ID=your_telegram_user_id
CHANNEL_LINK=https://t.me/+your_invite_hash
ALCHEMY_BASE_URL=https://base-mainnet.g.alchemy.com/v2/your_key
HELIUS_API_KEY=your_helius_api_key
# Payments older than this can't be claimed (replay guard)
PAYMENT_MAX_AGE_DAYS=3

# ── Optional ──────────────────────────────────────────────────────────────
# AI commentary / analysis (disabled when unset)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Channel autopost source: auspex (top Auspex signals, default) or gecko (old Base trending post)
AUTOPOST_SOURCE=auspex
# Elite channel for top-30 callers' calls
ELITE_CHANNEL_ID=

# X follow watcher — needs a paid X API plan; check current pricing at developer.x.com
X_BEARER_TOKEN=
FOLLOW_CHANNEL_ID=
# Public Nitter instances were all dead in Oct 2026; off by default
NITTER_FALLBACK=false

# Elfa smart-stats (v2 endpoint is retired on 2026-10-28; ignored after that unless ELFA_FORCE=1)
ELFA_API_KEY=

# Smart call watcher: groups to watch for CAs (the bot needs group privacy mode OFF to read messages)
SOURCE_CHAT_IDS=
SMART_CALL_CHANNEL_ID=
SMART_FOLLOWER_THRESHOLD=10
# SMART_CALL_UNGATED=1      # forward every CA, not just Auspex-board coins without hard flags

# ── Local testing only ────────────────────────────────────────────────────
# TELEGRAM_API_ROOT=http://127.0.0.1:56441   # mock Telegram API (scripts/e2e/mockTelegram.mjs)
# DISABLE_CRONS=1
