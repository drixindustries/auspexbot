{
  "name": "auspex-bot",
  "version": "1.0.0",
  "description": "Auspex Telegram bot: the Auspex signal feed, badges and alert rules in Telegram, plus callers, payments and autopost",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node --test test/*.test.js",
    "test:parity": "AUSPEX_SITE_HTML=${AUSPEX_SITE_HTML:-../auspex-site/index.html} AUSPEX_WORKER_SIGNAL_OUTCOMES=${AUSPEX_WORKER_SIGNAL_OUTCOMES:-../auspex-worker/lib/signal-outcomes.js} node --test test/parity.*.test.js",
    "lint": "eslint .",
    "check": "for f in *.js lib/*.js scripts/e2e/*.mjs; do node --check $f || exit 1; done",
    "e2e": "node scripts/e2e/run.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "@supabase/supabase-js": "^2.106.2",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "telegraf": "^4.16.3",
    "ws": "^8.22.0"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0"
  }
}
